<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/theme/vendor/jquery-nice-select/css/nice-select.css" rel="stylesheet">
  <link href="/theme/vendor/select2/css/select2.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/theme/css/style.css">


</head>

<body>
  <%- body %>
    <script>
      // Obtener elementos
      const passwordInput = document.getElementById("password");
      const togglePasswordButton = document.getElementById("toggle-password");
      const eyeIcon = document.getElementById("eye-icon");

      // Alternar la visibilidad de la contraseña
      togglePasswordButton.addEventListener("click", function () {
        if (passwordInput.type === "password") {
          passwordInput.type = "text"; // Muestra la contraseña
          eyeIcon.classList.remove("bi-eye-slash"); // Cambia el ícono
          eyeIcon.classList.add("bi-eye");
        } else {
          passwordInput.type = "password"; // Oculta la contraseña
          eyeIcon.classList.remove("bi-eye"); // Cambia el ícono
          eyeIcon.classList.add("bi-eye-slash");
        }
      });

      // Cuando el formulario se envíe
      document.getElementById("login-form").addEventListener("submit", function (event) {
        event.preventDefault();  // Previene que el formulario se envíe de la manera tradicional

        const email = document.getElementById("email").value;
        const password = document.getElementById("password").value;
        const rememberMe = document.getElementById("rememberMe").checked;

        if (rememberMe) {
          // Almacenar email (y opcionalmente un token) en Local Storage o cookies
          localStorage.setItem("userEmail", email);  // Aquí se almacena el correo
          // O puedes almacenar en una cookie con una fecha de expiración, por ejemplo:
          // document.cookie = `userEmail=${email}; max-age=31536000; path=/`; // 1 año
        } else {
          localStorage.removeItem("userEmail");
        }
        //alert('entra al submit');
        // Aquí podrías proceder con la autenticación del usuario
        console.log("Correo:", email);
        console.log("Contraseña:", password);

        // Hacer una solicitud POST al servidor para verificar las credenciales
        fetch('/api/auth/login', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ email, password })
        })
          .then(response => {
            if (response.ok) {
              // Lanza un error para ser capturado abajo
              //return response.json().then(err => { throw err });
              // Si la respuesta es exitosa, redirigir al usuario
              //window.location.href = '/index'; // Redirigir a la página principal
            } else {
              // Mostrar mensaje en pantalla
              //alert("contraseña incorrecta");
              //const mensaje = error.message || 'Ocurrió un error inesperado';
              const contenedor = document.getElementById('mensajeError');
              contenedor.innerText = 'Error: Email o Password incorrecto.';
              contenedor.style.display = 'block';
            }
            return response.json();
          });
          


        // Redirigiendo a la página principal
        //window.location.href = "/index"; // Redirige a la página principal
      });

      // Almacenar la cookie
      document.cookie = `userEmail=${email}; expires=Thu, 31 Dec 2025 12:00:00 UTC; path=/`;

      // Recuperar la cookie
      const cookies = document.cookie.split(';');
      cookies.forEach(cookie => {
        const [key, value] = cookie.trim().split('=');
        if (key === "userEmail") {
          console.log("Correo almacenado en cookie:", value);
        }
      });

      // Al cargar la página, verificar si el usuario tiene su correo almacenado
      document.addEventListener("DOMContentLoaded", function () {
        const storedEmail = localStorage.getItem("userEmail");
        if (storedEmail) {
          document.getElementById("email").value = storedEmail;  // Prellenar el correo
          document.getElementById("rememberMe").checked = true;  // Marcar la opción de "Recordarme"
        }
      });

    </script>
    <!-- select 2 -->
    <script src="/theme/vendor/global/global.min.js"></script>
    <script src="/theme/vendor/jquery-nice-select/js/jquery.nice-select.min.js"></script>
    <script src="/theme/vendor/select2/js/select2.full.min.js"></script>
    <script src="/theme/js/plugins-init/select2-init.js"></script>
    <script src="/theme/js/custom.min.js"></script>
    <script src="/theme/js/deznav-init.js"></script>
</body>

</html>