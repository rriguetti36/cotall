<div class="row page-titles">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="javascript:void(0)">App</a></li>
    <li class="breadcrumb-item  active"><a href="/productos">Productos</a></li>
  </ol>
</div>

<div class="col-xl-12 col-lg-12">
  <div class="card">
    <div class="card-header">
      <h4 class="card-title">Crear Productos y Servicios</h4>
    </div>
    <div class="card-body">
      <ul class="nav nav-pills mb-4 light">
        <li class=" nav-item">
          <a href="#productos" class="nav-link active" data-bs-toggle="tab" aria-expanded="false">Producto</a>
        </li>
      </ul>
      <div class="tab-content">
        <div id="productos" class="tab-pane active">
          <form id="frmProductos" enctype="multipart/form-data">
          <!-- <form id="frmProductos" action="/productos/create" method="POST" enctype="multipart/form-data"> -->
            <div class="row">
              <div class="mb-3 col-md-6">
                <label class="form-label">Tipo Producto o Servicio ofrecido</label>
                <select id="tipo" name="tipo" class="default-select form-control wide">
                  <% activos.forEach(activo=> { %>
                    <option value="<%= activo.id %>">
                      <%= activo.nombre %>
                    </option>
                    <% }); %>
                </select>
              </div>
              <div class="mb-3 col-md-6">
                <label class="form-label">Titulo</label>
                <div class="position-relative">
                  <input type="text" class="form-control" id="nombre" name="nombre" required>
                  <i class="bi bi-question-circle-fill position-absolute top-50 end-0 translate-middle-y me-3 text-primary"
                    data-bs-toggle="tooltip" title="Escribe el nombre del Producto o Servicio que estás registrando."
                    style="cursor: pointer; font-size: 1.2em;"></i>
                </div>

              </div>
              <div class="mb-3 col-md-6">
                <label class="form-label">Descripcion del producto o Servicio</label>
                <div class="position-relative">
                  <textarea class="form-control" rows="9" id="descripcion" name="descripcion"></textarea>
                  <i class="bi bi-question-circle-fill position-absolute top-50 end-0 translate-middle-y me-3 text-primary"
                    data-bs-toggle="tooltip"
                    title="Escribe una descripción corta del Producto Servicio. Detalles, Características, funciones o lo que describa los que se ofrece."
                    style="cursor: pointer; font-size: 1.2em;"></i>
                </div>

              </div>
              <div class="mb-3 col-md-6">
                <label class="form-label">Codigo SKU</label>
                <div class="position-relative">
                  <input type="text" class="form-control" id="codigo" name="codigo" required>
                  <i class="bi bi-question-circle-fill position-absolute top-50 end-0 translate-middle-y me-3 text-primary"
                    data-bs-toggle="tooltip" title="Digita el código interno del tu producto, si lo tuvieras.."
                    style="cursor: pointer; font-size: 1.2em;"></i>
                </div>

              </div>
            </div>
            <div class="row">
              <div class="mb-3 col-md-6">
                <label class="form-label">Categoria</label>
                <select id="idcat" name="idcat" class="default-select form-control wide">
                  <option value="0">Sin Marca</option>
                  <% categorias.forEach(categoria=> { %>
                    <option value="<%= categoria.id %>">
                      <%= categoria.nombre %>
                    </option>
                    <% }); %>
                </select>
              </div>
              <div class="mb-3 col-md-6">
                <label class="form-label">Marca</label>
                <select id="idmar" name="idmar" class="default-select form-control wide">
                  <option value="0">Sin Marca</option>
                  <% marcas.forEach(marca=> { %>
                    <option value="<%= marca.id %>">
                      <%= marca.nombre %>
                    </option>
                    <% }); %>
                </select>
              </div>
            </div>
            <div class="row">
              <div id="divprecio" class="mb-3 col-md-6">
                <label class="form-label">Precio lista</label>
                <input type="number" class="form-control" id="precio" name="precio" value="0" required>
              </div>
              <div id="divpreciorebaja" class="mb-3 col-md-6">
                <label class="form-label">Precio oferta</label>
                <input type="number" class="form-control" id="preciorebaja" name="preciorebaja" value="0">
              </div>
              <div id="divstock" class="mb-3 col-md-6">
                <label class="form-label">Stock</label>
                <div class="position-relative">
                  <input type="number" class="form-control" id="stock" name="stock" value="0">
                  <i class="bi bi-question-circle-fill position-absolute top-50 end-0 translate-middle-y me-3 text-primary"
                    data-bs-toggle="tooltip" title="Digita cantidad de unidades que tienes en stock"
                    style="cursor: pointer; font-size: 1.2em;"></i>
                </div>
              </div>
              <div class="mb-3 col-md-6">
                <label class="form-label">% impuesto IGV</label>
                <div class="position-relative">
                  <input type="number" class="form-control" id="impuesto" name="impuesto" value="<%= compania.mtoimp %>">
                  <i class="bi bi-question-circle-fill position-absolute top-50 end-0 translate-middle-y me-3 text-primary"
                    data-bs-toggle="tooltip"
                    title="IGV al producto. Es editable si no desea modificar este tomará el IGV configurado en la CIA."
                    style="cursor: pointer; font-size: 1.2em;"></i>
                </div>
              </div>
            </div>
            <div class="row">
              <div class="mb-3 col-md-6">
                <label class="form-label">Imagen del producto</label>
                <input class="form-control" type="file" id="imagen" name="imagen">
              </div>
            </div>
            <button type="submit" class="btn btn-primary">Crear Producto</button>
          </form>
        </div>
        
      </div>
    </div>
  </div>
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<!-- sweetalert -->
<script src="/theme/vendor/sweetalert2/dist/sweetalert2.min.js"></script>
<script src="/theme/js/plugins-init/sweetalert.init.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/public/js/producto.js"></script>